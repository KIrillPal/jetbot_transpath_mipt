<CycloneDDS>
 <Domain>
     <General>
         <MaxMessageSize>65500B</MaxMessageSize>
         <Interfaces>
             <!-- Publish DDS traffic to LAN for remote RViz -->
             <NetworkInterface address="192.168.50.94" multicast="true"/>
         </Interfaces>
         <DontRoute>false</DontRoute>
     </General>
     <Internal>
        <SocketReceiveBufferSize min="10MB"/>
        <Watermarks>
            <WhcHigh>500kB</WhcHigh>
        </Watermarks>
     </Internal>
 </Domain>
</CycloneDDS>
